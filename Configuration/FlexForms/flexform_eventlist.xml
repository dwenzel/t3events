<?xml version="1.0"?>
<T3DataStructure>
    <meta>
        <langDisable>1</langDisable>
    </meta>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_tab.settings</sheetTitle>
                <cshFile>LLL:EXT:t3events/Resources/Private/Language/locallang_csh_flexform.xml</cshFile>
                <type>array</type>
                <el>
                    <settings.order>
                        <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.sortBy</label>
                        <config>
                            <type>radio</type>
                            <items type="array">
                                <numIndex index="0" type="array">
                                    <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.date</label>
                                    <value>performances.date|asc,performances.begin|asc</value>
                                </numIndex>
                                <numIndex index="1" type="array">
                                    <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.dateDesc</label>
                                    <value>performances.date|desc,performances.begin|desc</value>
                                </numIndex>
                                <numIndex index="2" type="array">
                                    <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.title</label>
                                    <value>event.headline|asc</value>
                                </numIndex>
                            </items>
                        </config>
                    </settings.order>
                    <settings.maxItems>
                        <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.maxItems</label>
                        <config>
                            <type>number</type>
                            <size>3</size>
                            <eval>trim</eval>
                        </config>
                    </settings.maxItems>
                    <view.pluginNamespace>
                        <label>Plugin Namespace</label>
                        <config>
                            <type>input</type>
                            <eval>trim,nospace</eval>
                        </config>
                    </view.pluginNamespace>
                    <settings.cache.notCacheable>
                        <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.cache.makeNonCacheable</label>
                        <config>
                            <type>check</type>
                        </config>
                    </settings.cache.notCacheable>
                </el>
            </ROOT>
        </sDEF>
        <constraints>
            <ROOT>
                <sheetTitle>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xlf:flexforms_general.constraints</sheetTitle>
                <type>array</type>
                <el>
                    <settings.statuses>
                        <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.statuses</label>
                        <config>
                            <type>group</type>
                            <allowed>tx_t3events_domain_model_performancestatus</allowed>
                            <size>3</size>
                            <autoSizeMax>20</autoSizeMax>
                            <minitems>0</minitems>
                            <maxitems>20</maxitems>
                            <wizards>
                                <suggest>
                                    <type>suggest</type>
                                </suggest>
                            </wizards>
                        </config>
                    </settings.statuses>
                    <settings.excludeSelectedStatuses>
                        <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.excludeSelectedStatuses</label>
                        <config>
                            <type>check</type>
                        </config>
                    </settings.excludeSelectedStatuses>
                    <settings.period>
                        <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.period</label>
                        <onChange>reload</onChange>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items type="array">
                                <numIndex index="0" type="array">
                                    <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.period.all</label>
                                    <value>all</value>
                                </numIndex>
                                <numIndex index="1" type="array">
                                    <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.period.futureOnly</label>
                                    <value>futureOnly</value>
                                </numIndex>
                                <numIndex index="2" type="array">
                                    <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.period.pastOnly</label>
                                    <value>pastOnly</value>
                                </numIndex>
                                <numIndex index="3" type="array">
                                    <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.period.specific</label>
                                    <value>specific</value>
                                </numIndex>
                            </items>
                        </config>
                    </settings.period>
                    <legend>
                        <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.legendPeriodConstraints</label>
                        <config>
                            <type>user</type>
                            <renderType>t3eventsLegendPeriodConstraints</renderType>
                        </config>
                    </legend>
                    <settings.respectEndDate>
                        <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.respectEndDate</label>
                        <displayCond>FIELD:settings.period:!=:all</displayCond>
                        <onChange>reload</onChange>
                        <config>
                            <type>check</type>
                        </config>
                    </settings.respectEndDate>
                    <settings.periodType>
                        <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.constraintBy</label>
                        <onChange>reload</onChange>
                        <displayCond>FIELD:settings.period:=:specific</displayCond>
                        <config>
                            <type>radio</type>
                            <items type="array">
                                <numIndex index="0" type="array">
                                    <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.period.specific.byDay</label>
                                    <value>byDay</value>
                                </numIndex>
                                <numIndex index="1" type="array">
                                    <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.period.specific.byMonth</label>
                                    <value>byMonth</value>
                                </numIndex>
                                <numIndex index="2" type="array">
                                    <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.period.specific.byYear</label>
                                    <value>byYear</value>
                                </numIndex>
                                <numIndex index="3" type="array">
                                    <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.period.specific.byDate</label>
                                    <value>byDate</value>
                                </numIndex>
                            </items>
                        </config>
                    </settings.periodType>
                    <settings.periodStart>
                        <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.start</label>
                        <displayCond>
                            <AND>
                                <numIndex index="0">FIELD:settings.period:=:specific</numIndex>
                                <numIndex index="1">FIELD:settings.periodType:!=:byDate</numIndex>
                            </AND>
                        </displayCond>
                        <config>
                            <type>number</type>
                            <size>1</size>
                            <range>
                                <upper>999</upper>
                                <lower>-999</lower>
                            </range>
                            <eval>trim</eval>
                        </config>
                    </settings.periodStart>
                    <settings.periodDuration>
                        <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.duration</label>
                        <displayCond>
                            <AND>
                                <numIndex index="0">FIELD:settings.period:=:specific</numIndex>
                                <numIndex index="1">FIELD:settings.periodType:!=:byDate</numIndex>
                            </AND>
                        </displayCond>
                        <config>
                            <size>3</size>
                            <range>
                                <upper>999</upper>
                                <lower>1</lower>
                            </range>
                            <default>1</default>
                            <eval>trim</eval>
                            <type>number</type>
                        </config>
                    </settings.periodDuration>
                    <settings.periodStartDate>
                        <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.start</label>
                        <displayCond>FIELD:settings.periodType:=:byDate</displayCond>
                        <config>
                            <type>input</type>
                            <size>8</size>
                            <eval>date</eval>
                            <checkbox>1</checkbox>
                        </config>
                    </settings.periodStartDate>
                    <settings.periodEndDate>
                        <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.end</label>
                        <displayCond>FIELD:settings.periodType:=:byDate</displayCond>
                        <config>
                            <type>input</type>
                            <size>8</size>
                            <eval>date</eval>
                            <checkbox>1</checkbox>
                        </config>
                    </settings.periodEndDate>
                    <settings.categoryConjunction>
                        <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.conjunction</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0">
                                    <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.conjunction.or</label>
                                    <value>OR</value>
                                </numIndex>
                                <numIndex index="1">
                                    <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.conjunction.and</label>
                                    <value>AND</value>
                                </numIndex>
                            </items>
                        </config>
                    </settings.categoryConjunction>
                    <settings.venues>
                        <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.venues</label>
                        <config>
                            <type>group</type>
                            <allowed>tx_t3events_domain_model_venue</allowed>
                            <size>5</size>
                            <autoSizeMax>20</autoSizeMax>
                            <minitems>0</minitems>
                            <maxitems>20</maxitems>
                            <wizards>
                                <suggest>
                                    <type>suggest</type>
                                </suggest>
                            </wizards>
                        </config>
                    </settings.venues>
                    <settings.genres>
                        <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.quick_menu.type.genres</label>
                        <config>
                            <type>group</type>
                            <allowed>tx_t3events_domain_model_genre</allowed>
                            <size>5</size>
                            <autoSizeMax>20</autoSizeMax>
                            <minitems>0</minitems>
                            <maxitems>40</maxitems>
                            <wizards>
                                <suggest>
                                    <type>suggest</type>
                                </suggest>
                            </wizards>
                        </config>
                    </settings.genres>
                    <settings.eventTypes>
                        <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.quick_menu.type.eventtypes</label>
                        <config>
                            <type>group</type>
                            <allowed>tx_t3events_domain_model_eventtype</allowed>
                            <size>5</size>
                            <autoSizeMax>20</autoSizeMax>
                            <minitems>0</minitems>
                            <maxitems>40</maxitems>
                            <wizards>
                                <suggest>
                                    <type>suggest</type>
                                </suggest>
                            </wizards>
                        </config>
                    </settings.eventTypes>
                    <settings.categories>
                        <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.categories</label>
                        <exclude>1</exclude>
                        <config>
                            <type>select</type>
                            <renderType>selectTree</renderType>
                            <autoSizeMax>50</autoSizeMax>
                            <foreign_table>sys_category</foreign_table>
                            <foreign_table_where> AND sys_category.sys_language_uid IN (-1, 0) ORDER BY sys_category.sorting ASC</foreign_table_where>
                            <maxitems>9999</maxitems>
                            <renderMode>tree</renderMode>
                            <size>10</size>
                            <treeConfig>
                                <appearance>
                                    <expandAll>1</expandAll>
                                    <showHeader>1</showHeader>
                                </appearance>
                                <parentField>parent</parentField>
                            </treeConfig>
                        </config>
                    </settings.categories>
                </el>
            </ROOT>
        </constraints>
        <template>
            <ROOT>
                <sheetTitle>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xlf:flexforms_general.template</sheetTitle>
                <type>array</type>
                <el>
                    <settings.templateLayout>
                        <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.templateLayout</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <itemsProcFunc>DWenzel\T3events\Hooks\ItemsProcFunc->user_templateLayout</itemsProcFunc>
                            <items>
                                <numIndex index="0">
                                    <label>---</label>
                                    <value/>
                                </numIndex>
                            </items>
                        </config>
                    </settings.templateLayout>
                    <settings.hideIfEmptyResult>
                        <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xml:flexforms_general.hideIfEmptyResult</label>
                        <config>
                            <type>check</type>
                        </config>
                    </settings.hideIfEmptyResult>
                </el>
            </ROOT>
        </template>
        <pages>
            <ROOT>
                <sheetTitle>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xlf:flexforms_general.pages</sheetTitle>
                <type>array</type>
                <el>
                    <settings.listPid>
                        <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xlf:flexforms_general.listPage</label>
                        <config>
                            <type>group</type>
                            <allowed>pages</allowed>
                            <minitems>0</minitems>
                            <maxitems>1</maxitems>
                            <wizards>
                                <suggest>
                                    <type>suggest</type>
                                </suggest>
                            </wizards>
                        </config>
                    </settings.listPid>
                    <settings.detailPid>
                        <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xlf:flexforms_general.detailPage</label>
                        <config>
                            <type>group</type>
                            <allowed>pages</allowed>
                            <minitems>0</minitems>
                            <maxitems>1</maxitems>
                            <wizards>
                                <suggest>
                                    <type>suggest</type>
                                </suggest>
                            </wizards>
                        </config>
                    </settings.detailPid>
                    <settings.backPid>
                        <label>LLL:EXT:t3events/Resources/Private/Language/locallang_be.xlf:flexforms_general.backPage</label>
                        <config>
                            <type>group</type>
                            <allowed>pages</allowed>
                            <minitems>0</minitems>
                            <maxitems>1</maxitems>
                            <wizards>
                                <suggest>
                                    <type>suggest</type>
                                </suggest>
                            </wizards>
                        </config>
                    </settings.backPid>
                </el>
            </ROOT>
        </pages>
    </sheets>
</T3DataStructure>
