{
  "name": "dwenzel/t3events",
  "type": "typo3-cms-extension",
  "description": "Versatile events extension for the TYPO3 CMS",
  "keywords": [
    "TYPO3",
    "extension",
    "events"
  ],
  "license": [
    "GPL-2.0+"
  ],
  "authors": [
    {
      "name": "Dirk Wenzel",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-dom": "*",
    "typo3/cms-core": "^11.5",
    "typo3/cms-fluid": "^11.5",
    "dwenzel/t3extension-tools": "^2.0"
  },
  "require-dev": {
    "typo3/testing-framework": "^8.0",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "DWenzel\\T3events\\": "Classes"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DWenzel\\T3events\\Tests\\": "Tests",
      "Nimut\\TestingFramework\\TestCase\\": "Tests/Compatibility/TestCase/",
      "Nimut\\TestingFramework\\MockObject\\": "Tests/Compatibility/MockObject/",
      "TYPO3\\CMS\\Extbase\\Object\\": "Tests/Compatibility/Extbase/Object/",
      "TYPO3\\CMS\\Extbase\\Mvc\\View\\": "Tests/Compatibility/Extbase/Mvc/View/",
      "TYPO3\\CMS\\Extbase\\Mvc\\Web\\": "Tests/Compatibility/Extbase/Mvc/Web/",
      "TYPO3\\CMS\\Lang\\": "Tests/Compatibility/Lang/"
    }
  },
  "config": {
    "vendor-dir": ".Build/vendor",
    "bin-dir": ".Build/bin",
    "allow-plugins": {
      "typo3/cms-composer-installers": true,
      "typo3/class-alias-loader": true
    },
    "preferred-install": {
      "typo3/cms": "source",
      "typo3/cms-core": "source",
      "*": "dist"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "mkdir -p .Build/Web/typo3conf/ext/",
      "mkdir -p .Build/log/coverage/",
      "[ -L .Build/Web/typo3conf/ext/t3events ] || ln -snvf ../../../../. .Build/Web/typo3conf/ext/t3events"
    ]
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "t3events",
      "cms-package-dir": "{$vendor-dir}/typo3/cms",
      "web-dir": ".Build/Web"
    }
  }
}
