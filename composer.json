{
  "name": "dwenzel/t3events",
  "type": "typo3-cms-extension",
  "description": "Versatile events extension for the TYPO3 CMS",
  "keywords": [
    "TYPO3",
    "extension",
    "events"
  ],
  "license": [
    "GPL-2.0-or-later"
  ],
  "authors": [
    {
      "name": "Dirk Wenzel",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-dom": "*",
    "dwenzel/t3extension-tools": "^5.0 || ^6.1",
    "typo3/cms-backend": "^13.4 || ^14.3",
    "typo3/cms-core": "^13.4 || ^14.3",
    "typo3/cms-extbase": "^13.4 || ^14.3",
    "typo3/cms-fluid": "^13.4 || ^14.3",
    "typo3/cms-frontend": "^13.4 || ^14.3",
    "typo3/cms-install": "^13.4 || ^14.3"
  },
  "require-dev": {
    "a9f/typo3-fractor": "^0.5",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "saschaegerer/phpstan-typo3": "^2.1 || ^3.0",
    "ssch/typo3-rector": "^3.0",
    "typo3/cms-fluid-styled-content": "^13.4 || ^14.3",
    "typo3/testing-framework": "^8.2 || ^9.0"
  },
  "autoload": {
    "psr-4": {
      "DWenzel\\T3events\\": "Classes"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DWenzel\\T3events\\Tests\\": "Tests",
      "Nimut\\TestingFramework\\TestCase\\": "Tests/Compatibility/TestCase/",
      "Nimut\\TestingFramework\\MockObject\\": "Tests/Compatibility/MockObject/",
      "TYPO3\\CMS\\Extbase\\Object\\": "Tests/Compatibility/Extbase/Object/",
      "TYPO3\\CMS\\Extbase\\Mvc\\View\\": "Tests/Compatibility/Extbase/Mvc/View/",
      "TYPO3\\CMS\\Extbase\\Mvc\\Web\\": "Tests/Compatibility/Extbase/Mvc/Web/",
      "TYPO3\\CMS\\Lang\\": "Tests/Compatibility/Lang/"
    }
  },
  "config": {
    "vendor-dir": ".Build/vendor",
    "bin-dir": ".Build/bin",
    "allow-plugins": {
      "typo3/cms-composer-installers": true,
      "typo3/class-alias-loader": true,
      "a9f/fractor-extension-installer": true,
      "phpstan/extension-installer": true
    },
    "preferred-install": {
      "typo3/cms": "source",
      "typo3/cms-core": "source",
      "*": "dist"
    },
    "sort-packages": true
  },
  "scripts": {
    "post-autoload-dump": [
      "mkdir -p .Build/Web/typo3conf/ext/",
      "mkdir -p .Build/log/coverage/",
      "[ -L .Build/Web/typo3conf/ext/t3events ] || ln -snvf ../../../../. .Build/Web/typo3conf/ext/t3events"
    ],
    "test:unit": "phpunit -c phpunit.xml",
    "test:functional": "phpunit -c Tests/Build/FunctionalTests.xml",
    "rector:check": "rector process --dry-run",
    "rector:fix": "rector process",
    "fractor:check": "fractor process --dry-run",
    "fractor:fix": "fractor process",
    "phpstan": "phpstan analyse --no-progress"
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "t3events",
      "cms-package-dir": "{$vendor-dir}/typo3/cms",
      "web-dir": ".Build/Web"
    }
  },
  "scripts-descriptions": {
    "test:unit": "Run the unit tests",
    "test:functional": "Run the functional tests (SQLite unless typo3Database* variables are set)",
    "rector:check": "Show changes Rector would make (PHP)",
    "rector:fix": "Apply Rector changes (PHP)",
    "fractor:check": "Show changes Fractor would make (TypoScript, FlexForms, Fluid, YAML)",
    "fractor:fix": "Apply Fractor changes",
    "phpstan": "Static analysis (level and baseline in phpstan.neon)"
  },
  "support": {
    "docs": "https://docs.typo3.org/p/dwenzel/t3events/main/en-us/",
    "issues": "https://github.com/dwenzel/t3events/issues",
    "source": "https://github.com/dwenzel/t3events"
  }
}
