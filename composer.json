{
  "name": "dwenzel/t3events",
  "type": "typo3-cms-extension",
  "description": "Versatile events extension for the TYPO3 CMS",
  "keywords": [
    "TYPO3",
    "extension",
    "events"
  ],
  "license": [
    "GPL-2.0-or-later"
  ],
  "authors": [
    {
      "name": "Dirk Wenzel",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^7.4 || ^8.0",
    "typo3/cms-core": "^11.5",
    "typo3/cms-fluid": "^11.5",
    "dwenzel/t3extension-tools": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "typo3/testing-framework": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "DWenzel\\T3events\\": "Classes"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DWenzel\\T3events\\Tests\\": "Tests",
      "Nimut\\TestingFramework\\TestCase\\": "Tests/Compatibility/TestCase/",
      "Nimut\\TestingFramework\\MockObject\\": "Tests/Compatibility/MockObject/"
    }
  },
  "config": {
    "vendor-dir": ".Build/vendor",
    "bin-dir": ".Build/bin",
    "sort-packages": true,
    "allow-plugins": {
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true
    }
  },
  "scripts": {
    "test:unit": "phpunit -c Tests/Build/UnitTests.xml"
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "t3events",
      "web-dir": ".Build/Web"
    }
  }
}
